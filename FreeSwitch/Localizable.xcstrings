          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada una fila y arrástrala; si pasa un título de grupo, cambia a ese grupo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте строку и перетаскивайте вверх или вниз; за заголовком группы она перейдёт в эту группу."
          }
        }
      }
    },
    "绑全局快捷键": {
