    "「锁定键盘」要用它来拦截键盘事件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Lock Keyboard” uses it to intercept key events."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「鎖定鍵盤」要用它來攔截鍵盤事件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「キーボードをロック」がキー入力の横取りに使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘키보드 잠금’이 키 입력을 가로채는 데 사용합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Tastatur sperren“ fängt damit Tastenereignisse ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Verrouiller le clavier » s’en sert pour intercepter les touches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Bloquear teclado» lo usa para interceptar las pulsaciones."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Заблокировать клавиатуру» перехватывает с его помощью нажатия клавиш."
          }
        }
      }
    },
