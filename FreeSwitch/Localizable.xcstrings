    "彻底卸载 FreeSwitch？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstall FreeSwitch?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "徹底解除安裝 FreeSwitch？"
