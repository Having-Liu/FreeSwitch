          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t start the uninstall script"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒能啟動解除安裝指令稿"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アンインストールスクリプトを起動できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제거 스크립트를 시작하지 못했습니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deinstallationsskript konnte nicht gestartet werden"
