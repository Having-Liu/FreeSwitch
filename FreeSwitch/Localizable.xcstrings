            "value": "„Steuerelemente bearbeiten“ wählen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez « Modifier les contrôles »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige «Editar controles»"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Настроить элементы»"
          }
        }
      }
    },
    "在控制中心里往下滚到底，点「编辑控件」": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll to the bottom of Control Center and click “Edit Controls”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在控制中心裡往下捲到底，點「編輯控制項目」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントロールセンターを下までスクロールし、「コントロールを編集」をクリックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제어 센터를 아래 끝까지 스크롤한 뒤 ‘제어 항목 편집’을 클릭하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll im Kontrollzentrum ganz nach unten und klicke auf „Steuerelemente bearbeiten“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Descendez tout en bas du Centre de contrôle et cliquez sur « Modifier les contrôles »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja del todo en el Centro de Control y haz clic en «Editar controles»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутите Пункт управления вниз до конца и нажмите «Настроить элементы»."
          }
        }
      }
    },
    "找到 FreeSwitch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find FreeSwitch"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找到 FreeSwitch"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FreeSwitch を探す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FreeSwitch 찾기"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FreeSwitch finden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez FreeSwitch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca FreeSwitch"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите FreeSwitch"
          }
        }
      }
    },
    "左侧列表里选 FreeSwitch，把想要的控件拖进去": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick FreeSwitch in the list on the left and drag the controls you want into place."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左側清單裡選 FreeSwitch，把想要的控制項目拖進去。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左の一覧から FreeSwitch を選び、使いたいコントロールをドラッグして入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 목록에서 FreeSwitch를 고르고 원하는 제어 항목을 끌어다 놓으세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle links in der Liste FreeSwitch und zieh die gewünschten Steuerelemente hinein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez FreeSwitch dans la liste de gauche et glissez-y les contrôles voulus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona FreeSwitch en la lista de la izquierda y arrastra los controles que quieras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите FreeSwitch в списке слева и перетащите нужные элементы."
          }
        }
      }
    },
    "控件只放系统没有的": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only what the system lacks"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制項目只放系統沒有的"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムに無いものだけ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템에 없는 것만"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur, was das System nicht hat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement ce que le système n’a pas"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lo que el sistema no tiene"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только то, чего нет в системе"
          }
        }
      }
    },
    "深色模式、低电量、锁定屏幕这些系统自己就有，不重复占位": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dark Mode, Low Power and Lock Screen already ship with macOS, so we don’t duplicate them."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "深色模式、低耗電、鎖定螢幕這些系統自己就有，不重複佔位。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダークモード・低電力・画面ロックは macOS に元からあるので、重複させません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다크 모드, 저전력, 화면 잠금은 macOS에 이미 있어 중복하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkelmodus, Stromsparmodus und Bildschirm sperren gibt es schon in macOS – wir doppeln sie nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode sombre, l’économie d’énergie et le verrouillage existent déjà dans macOS : pas de doublon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo oscuro, el bajo consumo y bloquear pantalla ya vienen con macOS; no los duplicamos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тёмный режим, энергосбережение и блокировка экрана уже есть в macOS — мы их не дублируем."
          }
        }
      }
    },
    "按需授权就好": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant only what you use"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按需授權就好"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要なぶんだけ許可を"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요한 것만 허용하세요"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur erteilen, was du nutzt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’autorisez que ce que vous utilisez"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concede solo lo que uses"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешайте только нужное"
          }
        }
      }
    },
    "用到哪项才需要哪项。现在全部跳过也完全可以用。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each one is only needed by the features that use it. Skipping them all right now is perfectly fine."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用到哪項才需要哪項。現在全部跳過也完全可以用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使う機能に必要なものだけで構いません。今すべて飛ばしても問題なく使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하는 기능에 필요한 것만 있으면 됩니다. 지금 전부 건너뛰어도 문제없이 쓸 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede wird nur von den Funktionen gebraucht, die sie nutzen. Du darfst jetzt auch alle überspringen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chacune n’est requise que par les fonctions qui l’utilisent. Vous pouvez toutes les passer maintenant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada uno solo hace falta para las funciones que lo usan. Puedes omitirlos todos ahora mismo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое нужно только тем функциям, которые его используют. Можно спокойно пропустить все сейчас."
          }
        }
      }
    },
    "给「黑暗模式」和「自动隐藏程序坞」用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used by “Dark Mode” and “Auto-hide Dock”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給「深色模式」和「自動隱藏 Dock」用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ダークモード」と「Dock を自動的に隠す」が使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘다크 모드’와 ‘Dock 자동 가리기’가 사용합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird von „Dunkelmodus“ und „Dock automatisch ausblenden“ genutzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisée par « Mode sombre » et « Masquer le Dock »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo usan «Modo oscuro» y «Ocultar el Dock»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется «Тёмным режимом» и «Автоскрытием Dock»."
          }
        }
      }
    },
    "给「清空废纸篓」，以及「隐藏所有窗口」时折叠访达的窗口用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used by “Empty Trash”, and to collapse Finder windows for “Hide All Windows”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給「清倒垃圾桶」，以及「隱藏所有視窗」時摺疊 Finder 視窗用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ゴミ箱を空にする」と、「すべてのウインドウを隠す」で Finder のウインドウをしまうのに使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘휴지통 비우기’, 그리고 ‘모든 윈도우 가리기’에서 Finder 윈도우를 접을 때 사용합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird von „Papierkorb leeren“ genutzt und um bei „Alle Fenster ausblenden“ die Finder-Fenster einzuklappen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisée par « Vider la corbeille » et pour réduire les fenêtres du Finder lors de « Masquer toutes les fenêtres »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La usan «Vaciar la papelera» y el plegado de ventanas del Finder en «Ocultar todas las ventanas»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется «Очисткой корзины» и сворачиванием окон Finder при «Скрыть все окна»."
          }
        }
      }
    },
    "给「锁定键盘」用——擦屏幕时不怕误触": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used by “Lock Keyboard” — wipe the screen without hitting anything."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給「鎖定鍵盤」用——擦螢幕時不怕誤觸。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「キーボードをロック」が使います。画面を拭いても誤入力しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘키보드 잠금’이 사용합니다. 화면을 닦아도 오입력 걱정이 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird von „Tastatur sperren“ genutzt – Bildschirm putzen, ohne etwas auszulösen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisée par « Verrouiller le clavier » — nettoyez l’écran sans rien déclencher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La usa «Bloquear teclado»: limpia la pantalla sin pulsar nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется «Блокировкой клавиатуры» — протирайте экран, ничего не нажав."
          }
        }
      }
    },
    "不给也不影响其它开关": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declining doesn’t break anything else"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不給也不影響其它開關"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可しなくても他のスイッチには影響しません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하지 않아도 다른 스위치에는 영향이 없습니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ablehnen beeinträchtigt nichts anderes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refuser ne casse rien d’autre"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechazarlo no afecta a nada más"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отказ ни на что другое не влияет"
          }
        }
      }
    },
    "没授权的开关会明说原因，不会默默失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A switch without its permission says why, instead of quietly doing nothing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒授權的開關會明說原因，不會默默失敗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可のないスイッチは理由をはっきり伝えます。黙って何も起きない、ということはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한이 없는 스위치는 이유를 분명히 알려 줍니다. 조용히 실패하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schalter ohne Berechtigung sagt, warum – statt still nichts zu tun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interrupteur sans autorisation explique pourquoi, au lieu d’échouer en silence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruptor sin permiso explica por qué, en vez de fallar en silencio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключатель без разрешения объяснит причину, а не промолчит."
          }
        }
      }
    },
    "关掉这个窗口之后": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you close this window"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關掉這個視窗之後"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウインドウを閉じたら"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 윈도우를 닫은 뒤"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du dieses Fenster schließt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir fermé cette fenêtre"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando cierres esta ventana"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После закрытия этого окна"
          }
        }
      }
    },
    "点菜单栏右上角那个拨杆图标，就能打开面板": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the toggle-handle icon in your menu bar to open the panel."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選單列右上角那個撥桿圖示，就能打開面板。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーのレバー型アイコンをクリックすればパネルが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대의 레버 모양 아이콘을 클릭하면 패널이 열립니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klick auf das Kipphebel-Symbol in der Menüleiste, um das Panel zu öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur l’icône en forme de levier dans la barre des menus pour ouvrir le panneau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el icono de palanca de la barra de menús para abrir el panel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите значок-рычажок в строке меню, чтобы открыть панель."
          }
        }
      }
    },
    "跟随系统": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match system"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟隨系統"
          }
        },
        "ja": {
