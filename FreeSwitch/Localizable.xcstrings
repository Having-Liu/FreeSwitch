    "界面语言。切换后需要重新启动才会生效。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language of the interface. Changing it takes effect after a restart."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "介面語言。切換後需要重新啟動才會生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示言語です。変更は再起動後に反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터페이스 언어입니다. 변경하면 재시작 후 적용됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache der Oberfläche. Eine Änderung wirkt nach einem Neustart."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue de l’interface. Le changement prend effet après un redémarrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma de la interfaz. El cambio se aplica tras reiniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык интерфейса. Изменение вступит в силу после перезапуска."
          }
        }
      }
    },
