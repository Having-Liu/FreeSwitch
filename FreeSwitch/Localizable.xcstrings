    "「耳机连接」要用它来连接和断开你选的设备": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Headphones” uses it to connect and disconnect the device you picked."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「耳機連線」要用它來連接和中斷你選的裝置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ヘッドフォン接続」が選んだデバイスの接続・解除に使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘헤드폰 연결’이 선택한 기기를 연결·해제하는 데 사용합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Kopfhörer“ verbindet und trennt damit das gewählte Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Écouteurs » s’en sert pour connecter et déconnecter l’appareil choisi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Auriculares» lo usa para conectar y desconectar el dispositivo elegido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Наушники» использует его для подключения и отключения выбранного устройства."
          }
        }
      }
    },
